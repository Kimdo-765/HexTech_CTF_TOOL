+    ))
+    client._codex_bin = "/usr/local/bin/codex"
+    original_exec = asyncio.create_subprocess_exec
+    original_emit = codex_cli.emit_gpt_event
+    original_cap = codex_cli.MAX_JSONL_EVENT_BYTES
+    emitted: list[str] = []
