# Anthropic API key. Leave empty to use Claude Code OAuth instead — run
# `claude login` on the host once and the worker mounts ~/.claude so the
# bundled `claude` CLI uses your claude.ai subscription token.
ANTHROPIC_API_KEY=

# Override if your host's Claude config is not at ~/.claude
# HOST_CLAUDE_HOME=/home/youruser/.claude

# Host path of the Grok Build config (agent_provider=grok), bind-mounted into
# api + worker. PIN IT — do not rely on the ${HOME} default in
# docker-compose.yml: a snap-confined `docker` CLI reports HOME as
# ~/snap/docker/<rev>, so `docker compose up -d` through /snap/bin/docker
# mounts an empty directory there and the worker silently loses the grok
# binary and its auth. `docker compose restart` keeps the old mount, so only a
# RECREATE exposes it.
# HOST_GROK_HOME=/home/youruser/.grok

# HexTech-only Codex runtime path (agent_provider=gpt). Keep this SEPARATE from
# the host TUI's ~/.codex: api/workers run as root and a shared rw mount can
# replace ~/.codex/config.toml with a root-owned 0600 file. start.sh copies only
# ~/.codex/auth.json here on first use; sessions and token refreshes then stay
# isolated. Treat auth.json like a password; never commit it.
# HOST_CODEX_HOME=/home/youruser/.codex-hextech

# GPT backend: `codex` (default, ChatGPT subscription OAuth) or `responses`
# (direct Platform API billing; requires OPENAI_API_KEY).
AGENT_PROVIDER=claude
GPT_RUNTIME=codex
GPT_MODEL=gpt-5.6-sol
GPT_EFFORT=medium
OPENAI_API_KEY=

# Claude model to use (default: claude-opus-4-7 with 1M context)
CLAUDE_MODEL=claude-opus-4-7

# Per-turn max output tokens passed to the SDK. We default to a very
# large number so the model's own ceiling (Sonnet/Opus ~64k) becomes
# the effective limit and the agent never gets truncated mid-thought.
# Lower this if you want to cap spend / response length.
CLAUDE_CODE_MAX_OUTPUT_TOKENS=999999

# Trip-wire: stop a web/pwn/crypto/rev job after this many tool calls
# if the agent still hasn't written exploit.py / solver.py. Catches
# investigation-loop runaway before the SDK exhausts the conversation
# context. 0 disables the trip-wire.
INVESTIGATION_BUDGET=0

# Cost circuit-breaker: HALT a job (recoverable via /retry) once TOTAL spend
# (main + subagents, $) reaches this ceiling. DISABLED BY DEFAULT (0 / unset)
# across all modules — set to a positive dollar amount to re-arm a spend
# backstop against a runaway anchored grind. 0 or ≤0 = no cap.
COST_CAP_USD=0

# Redis (default points to docker-compose service)
REDIS_URL=redis://redis:6379/0

# Web UI port
WEB_PORT=8000

# Auto-start the cloudflared OOB tunnel on bring-up. When 1 (default),
# ./start.sh and ./restart.sh launch tunnel.sh in the background, which runs a
# cloudflared quick-tunnel and auto-sets the Callback URL in /data/settings.json
# (no ngrok interstitial, no manual copy). Set 0 to skip (e.g. you run your own
# tunnel). No-ops cleanly if cloudflared isn't installed. Stop a running tunnel
# with `./tunnel.sh stop`.
AUTO_TUNNEL=1

# KVM passthrough for pwn KERNEL challenges. When 1 (default) AND the host has
# /dev/kvm, ./start.sh generates docker-compose.override.yml so the worker's
# qemu-system-x86_64 can boot a chal's own kernel with -enable-kvm. Set 0 to
# disable the passthrough even where /dev/kvm exists. No effect on hosts
# without /dev/kvm (the override is only generated when the device is present).
ENABLE_KVM=1

# Job timeout (seconds). NOTHING fires when this elapses — the soft deadline
# and its continue/kill banner were removed. It only scales RQ's hard kill
# ceiling: min(max(JOB_TIMEOUT*4, 24h), 7d). What actually bounds a run is
# INVESTIGATION_BUDGET, COST_CAP_USD, the judge loop and the Stop button.
JOB_TIMEOUT=900

# --- Memory budget -----------------------------------------------------------
# These must ADD UP to less than the VM/host RAM. Docker caps each container
# individually; there is no global ceiling across them.
#
#   worker (WORKER_MEM_LIMIT)          8 GB
# + chal containers (CHAL_CONTAINER_MEM x WORKER_CONCURRENCY)   3 x 2 GB
# + api + redis + dockerd + host                              ~1 GB
#   -------------------------------------------------------------------
#   ~15 GB, inside a 16 GB VM.
#
# On 2026-08-01 this did not add up: the worker was 12g and challenge
# containers were UNLIMITED, so one chal image (socat fork-per-connection,
# ~1-2 GB/min per forked process) exhausted a 16 GB WSL2 VM and took it down.
# No container was OOMKilled — an uncapped container has no cgroup limit to
# hit, so the kernel ran out globally instead.
WORKER_MEM_LIMIT=8g

# Default --memory the docker shim (worker/docker_memguard.sh) injects into an
# agent-started `docker run`/`create` that omits one. A caller's own --memory
# still wins. Set to 0 to disable injection.
CHAL_CONTAINER_MEM=2g

# Absolute host path of ./data — required by Pwn/Forensic/Misc modules so
# the worker can bind-mount the job directory into sibling containers
# spawned via docker.sock. Set this to the absolute path of <repo>/data.
HOST_DATA_DIR=/home/youruser/HexTech_CTF_TOOL/data

# Number of parallel worker processes (concurrent jobs). Each pulls
# independently from the same Redis queue. Restart the worker container
# (`docker compose restart worker`) for changes to take effect.
WORKER_CONCURRENCY=3

# Job retention. Jobs older than this many days are auto-deleted by the
# worker's cleanup thread. Set to 0 to keep forever.
JOB_TTL_DAYS=7

# Ghidra version used by the decompiler image (pwn + rev). Override and
# rebuild to switch versions. Both must match a GitHub release:
#   ghidra_<VERSION>_PUBLIC_<DATE>.zip
GHIDRA_VERSION=12.0.4
GHIDRA_BUILD_DATE=20260303

# Shared auth token. If non-empty, the Web UI and API require this token
# (Authorization: Bearer <token> or ?token=<token>). Empty = no auth.
AUTH_TOKEN=
